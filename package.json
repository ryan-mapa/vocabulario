{
  "name": "vocabulario",
  "version": "1.0.0",
  "description": "A Spanish vocabulary game with Leitner-box spaced repetition",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "watch": "vitest",
    "serve": "python3 -m http.server 8000",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 migrations apply vocabulario --remote",
    "db:local": "wrangler d1 migrations apply vocabulario --local"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "wrangler": "^4.128.0"
  }
}
